# Postgres connection (self-hosted homelab)
# docker compose builds DATABASE_URL automatically for the "app" container
# from the three vars below — you don't set DATABASE_URL yourself when
# running via `docker compose up`.
POSTGRES_DB=cricket
POSTGRES_USER=cricket
POSTGRES_PASSWORD=changeme

# Teams made in the app are kept in a second database, cricintell_app, created
# by ./db/app/setup.sh. docker compose builds APP_DATABASE_URL automatically.

# Only needed for local `next dev` (outside Docker), e.g. pointed at the
# homelab over Tailscale:
# DATABASE_URL=postgres://cricket:changeme@<tailscale-hostname>:5432/cricket
# APP_DATABASE_URL=postgres://cricket:changeme@<tailscale-hostname>:5432/cricintell_app_dev
